[Unit]
Description=ФСТЭК Сервис (backend)
After=network.target

[Service]
Type=simple
ExecStart=/opt/fstec-service/backend/fstec-backend
WorkingDirectory=/opt/fstec-service/backend
Environment=FSTEC_DATA_DIR=/var/lib/fstec-service
Environment=FSTEC_FRONTEND_DIR=/opt/fstec-service/frontend
Environment=FSTEC_DISABLE_DOCS=1
Restart=on-failure
RestartSec=3
User=fstec
Group=fstec
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fstec-service
PrivateTmp=true

[Install]
WantedBy=multi-user.target
