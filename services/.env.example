# Общие настройки микросервисов (ТЗ 3.x). Скопируйте в .env и подставьте значения.

# --- Событийная шина: memory (dev, без Kafka) | kafka (prod) ---
FSTEC_EVENT_BUS=memory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Хранилище (SQLite для dev, PostgreSQL для prod) ---
DATABASE_URL=sqlite:///./data/fstec_services.db
# DATABASE_URL=postgresql+psycopg2://fstec:fstec@localhost:5432/fstec
FSTEC_DATA_DIR=./data

# --- Auth (обязательно сменить в prod!) ---
# FSTEC_SECRET_KEY: строго уникальный секрет; при отсутствии используется НЕБЕЗОПАСНЫЙ dev-дефолт
#   (режим отладки нельзя использовать на боевом сервере).
FSTEC_SECRET_KEY=dev-insecure-change-me
FSTEC_TOKEN_MINUTES=120
# Лимит попыток логина с одного IP в окне (анти-брутфорс)
FSTEC_LOGIN_RATE_LIMIT=10
FSTEC_LOGIN_RATE_WINDOW_S=60
# FSTEC_DISABLE_LOGIN_RATE_LIMIT=1  # только для автотестов

# --- Ингрест (ТЗ 2.1-2.2) ---
FSTEC_OCR_ENABLED=false
FSTEC_OCR_LANG=rus+eng
# auto (paddle→tesseract) | paddle | tesseract
FSTEC_OCR_ENGINE=auto
# gpu (CUDA, RTX 4090) | cpu
FSTEC_OCR_DEVICE=cpu

# --- LLM (ТЗ 2.3): heuristic | vllm ---
FSTEC_LLM_PROVIDER=heuristic
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen3-14B-Instruct-Q4
# Таймаут одного запроса к vLLM (свойственно для Qwen3-14B на GPU; увеличьте при медленной сети)
FSTEC_LLM_TIMEOUT_S=10
# Лимит токенов ответа классификатора (summary до 500 символов + entities)
FSTEC_VLLM_MAX_TOKENS=400

# --- RuBERT (быстрый предиктор категорий, CPU; GPU под vLLM) ---
FSTEC_RUBERT_MODEL=DeepPavlov/rubert-base-cased-conversational
FSTEC_RUBERT_DEVICE=cpu
FSTEC_RUBERT_CONFIDENCE=0.35

# --- Security (ТЗ 2.4): mock (dev/CI, без внешних БД) | live (всегда, graceful+failover) ---
FSTEC_SECURITY_MODE=live
FSTEC_SECURITY_RETRY_MAX=3
FSTEC_SECURITY_CACHE_TTL_S=86400
# NVD API v2 (https://services.nvd.nist.gov/rest/json/cves/2.0)
NVD_API_BASE=https://services.nvd.nist.gov
NVD_API_KEY=
# BDU ФСТЭК (HTML-страница /vul?unid=...)
BDU_API_BASE=https://bdu.fstec.ru
# Fallback verify=False при сбое проверки TLS (только dev-стенды! в prod оставить 0)
FSTEC_BDU_INSECURE_FALLBACK=0
# CMDB: mock (встроенный инвентарь) | rest (внешняя CMDB Заказчика)
CMDB_PROVIDER=mock
CMDB_ENDPOINT=http://localhost:9000/api/inventory/software
CMDB_AUTH_TYPE=none        # none | bearer | basic
CMDB_AUTH_TOKEN=
CMDB_TIMEOUT_S=5

# --- Отчётность (ТЗ 2.5) ---
FSTEC_ORG_NAME=Правительства Липецкой области

# --- Gateway (ТЗ 2.6) ---
FSTEC_GATEWAY_PORT=8666