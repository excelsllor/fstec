# Общие настройки микросервисов (ТЗ 3.x). Скопируйте в .env и подставьте значения.

# --- Событийная шина: memory (dev, без Kafka) | kafka (prod) ---
FSTEC_EVENT_BUS=memory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Хранилище (SQLite для dev, PostgreSQL для prod) ---
DATABASE_URL=sqlite:///./data/fstec_services.db
# DATABASE_URL=postgresql+psycopg2://fstec:fstec@localhost:5432/fstec
FSTEC_DATA_DIR=./data

# --- Профиль развёртывания: dev | prod (в prod небезопасные дефолты запрещены) ---
FSTEC_ENV=prod

# --- Auth (обязательно сменить в prod!) ---
# FSTEC_SECRET_KEY: строго уникальный секрет >= 32 символов. В prod обязателен
#   (иначе сервис не стартует). Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
FSTEC_SECRET_KEY=
FSTEC_TOKEN_MINUTES=120
# Пароль bootstrap-администратора (если не задан — генерируется и пишется в
#   data/bootstrap_password.txt с правами 0600; в лог пароль не попадает).
FSTEC_BOOTSTRAP_PASSWORD=
# CORS: список разрешённых origin через запятую. В prod по умолчанию пусто
#   (UI и API на одном origin через nginx); для dev — localhost:5173.
# FSTEC_CORS_ORIGINS=https://fstec.example.local
# Отключение /api/docs и /api/openapi.json (в prod = 1).
FSTEC_DISABLE_DOCS=1
# Лимит попыток логина с одного IP в окне (анти-брутфорс)
FSTEC_LOGIN_RATE_LIMIT=10
FSTEC_LOGIN_RATE_WINDOW_S=60
# FSTEC_DISABLE_LOGIN_RATE_LIMIT=1  # только для автотестов

# --- Ингрест (ТЗ 2.1-2.2) ---
FSTEC_OCR_ENABLED=false
FSTEC_OCR_LANG=rus+eng
# auto (paddle→tesseract) | paddle | tesseract
FSTEC_OCR_ENGINE=auto
# gpu (CUDA, RTX 4090) | cpu
FSTEC_OCR_DEVICE=cpu

# --- LLM (ТЗ 2.3): heuristic | vllm ---
FSTEC_LLM_PROVIDER=vllm
# В docker-compose адрес внутренний; при инференсе на хосте — http://<host>:8000/v1
VLLM_BASE_URL=http://vllm:8000/v1
# Имя модели, отдаваемое vLLM (--served-model-name) и используемое клиентом
VLLM_MODEL=Qwen3.5-9B
# HF-репозиторий весов для контейнера vllm (скачивается при первом старте)
VLLM_MODEL_ID=Qwen/Qwen3.5-9B
VLLM_MAX_MODEL_LEN=16384
# Доля VRAM под vLLM (0.80 — оставляем запас под PaddleOCR на той же 4090)
VLLM_GPU_MEMORY_UTILIZATION=0.80
# HF_TOKEN — если модель/репозиторий требует авторизации
HF_TOKEN=
# Таймаут одного запроса к vLLM (увеличьте при медленной сети)
FSTEC_LLM_TIMEOUT_S=10
# Лимит токенов ответа классификатора (summary до 500 символов + entities)
FSTEC_VLLM_MAX_TOKENS=400

# --- RuBERT (быстрый предиктор категорий, CPU; GPU под vLLM) ---
FSTEC_RUBERT_MODEL=DeepPavlov/rubert-base-cased-conversational
FSTEC_RUBERT_DEVICE=cpu
FSTEC_RUBERT_CONFIDENCE=0.35

# --- Security (ТЗ 2.4): mock (dev/CI, без внешних БД) | live (всегда, graceful+failover) ---
FSTEC_SECURITY_MODE=live
FSTEC_SECURITY_RETRY_MAX=3
FSTEC_SECURITY_CACHE_TTL_S=86400
# NVD API v2 (https://services.nvd.nist.gov/rest/json/cves/2.0)
NVD_API_BASE=https://services.nvd.nist.gov
NVD_API_KEY=
# BDU ФСТЭК (HTML-страница /vul?unid=...)
BDU_API_BASE=https://bdu.fstec.ru
# Fallback verify=False при сбое проверки TLS (только dev-стенды! в prod оставить 0)
FSTEC_BDU_INSECURE_FALLBACK=0
# CMDB: mock (встроенный инвентарь) | rest (внешняя CMDB Заказчика)
CMDB_PROVIDER=mock
CMDB_ENDPOINT=http://localhost:9000/api/inventory/software
CMDB_AUTH_TYPE=none        # none | bearer | basic
CMDB_AUTH_TOKEN=
CMDB_TIMEOUT_S=5

# --- Отчётность (ТЗ 2.5) ---
FSTEC_ORG_NAME=Правительства Липецкой области

# --- Gateway (ТЗ 2.6) ---
FSTEC_GATEWAY_PORT=8666

# --- docker-compose prod ---
# Порт UI (nginx) наружу для клиентов в локалке
FSTEC_HTTP_PORT=80
# Postgres (используется сервисом postgres и DATABASE_URL). Пароль обязателен.
POSTGRES_USER=fstec
POSTGRES_PASSWORD=
POSTGRES_DB=fstec
# Redis: пароль обязателен (requirepass)
REDIS_PASSWORD=
# DATABASE_URL для compose подставляется автоматически; для запуска без docker:
# DATABASE_URL=postgresql+psycopg2://fstec:<POSTGRES_PASSWORD>@localhost:5432/fstec